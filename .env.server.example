# Copy to .env on the server and replace every CHANGE_ME value.
APP_BIND=0.0.0.0
APP_PORT=5180
DJANGO_ALLOWED_HOSTS=CHANGE_ME_SERVER_IP,127.0.0.1,localhost,backend
CSRF_TRUSTED_ORIGINS=http://CHANGE_ME_SERVER_IP:5180
# Set 1 with HTTPS. An IP-only HTTP demo needs 0 for login cookies.
DJANGO_COOKIE_SECURE=0
DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
TEACHER_PASSWORD=CHANGE_ME_TEACHER_PASSWORD
